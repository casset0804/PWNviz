# PWNviz backend configuration. Copy to .env and adjust for your host.
# The backend runs inside WSL2/Ubuntu where GDB is available.
#
# Public names:
#   GDB_PATH            GDB binary: a command on PATH or an absolute host path
#   PWNDBG_INIT         pwndbg gdbinit.py file or its directory (optional)
#   API_HOST            bind address for the backend
#   API_PORT            bind port for the backend
#   ALLOWED_SAMPLE_DIR  only samples below this directory are discovered
#
# Empty values fall back to safe defaults; no host absolute path is compiled in.

GDB_PATH=gdb
PWNDBG_INIT=
API_HOST=127.0.0.1
API_PORT=8000
ALLOWED_SAMPLE_DIR=


# ---------------------------------------------------------------------------
# Optional tuning (PWNVIZ_*)
# ---------------------------------------------------------------------------

# Load pwndbg when detected. false = native GDB only.
PWNVIZ_LOAD_PWNDBG=true

# Browser origins allowed to call the API directly (the Vite dev server proxies
# same-origin requests as well).
PWNVIZ_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local-only safety rails. The backend spawns GDB, so binding a non-loopback
# API_HOST is refused unless PWNVIZ_ALLOW_REMOTE=1 is set deliberately.
# PWNVIZ_ALLOW_REMOTE=0
# Host header allowlist (DNS-rebinding defence). Extend this if you deliberately
# expose the backend under another hostname.
# PWNVIZ_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

PWNVIZ_LOG_LEVEL=INFO

# Probe budgets (seconds) and capability cache TTL (seconds).
PWNVIZ_PROBE_TIMEOUT_SECONDS=10
PWNVIZ_PWNDBG_PROBE_TIMEOUT_SECONDS=45
PWNVIZ_CAPABILITIES_CACHE_SECONDS=30

# Stack window used by the Phase 1 snapshot collector (bytes).
PWNVIZ_STACK_WINDOW_BELOW=128
PWNVIZ_STACK_WINDOW_ABOVE=384
PWNVIZ_MAX_STACK_READ_BYTES=1024
PWNVIZ_MEMORY_CHUNK_SIZE=64

# GDB process arguments. --batch is removed automatically because the session
# needs a persistent MI3 process; --interpreter=mi3 is appended if absent.
PWNVIZ_GDB_ARGS=--quiet --nx --interpreter=mi3
PWNVIZ_GDB_COMMAND_TIMEOUT_SECONDS=10
PWNVIZ_GDB_STOP_TIMEOUT_SECONDS=15

# Snapshot/session limits.
PWNVIZ_SESSION_MAX_SNAPSHOTS=200
PWNVIZ_SESSION_MAX_ACTIVE=8
# Reap abandoned sessions without an active WebSocket after this many seconds.
# Activity includes launch/actions/GET info/snapshots and an attached WS client.
PWNVIZ_SESSION_IDLE_TIMEOUT_SECONDS=1800
PWNVIZ_SESSION_REAPER_INTERVAL_SECONDS=30
PWNVIZ_SNAPSHOT_MAX_FRAMES=32
PWNVIZ_DISASSEMBLY_BEFORE=32
PWNVIZ_DISASSEMBLY_AFTER=64

# ---------------------------------------------------------------------------
# V1.1 performance knobs
# ---------------------------------------------------------------------------

# Default snapshot mode for steps: "fast" (recommended) or "full".
# launch and POST /sessions/{id}/refresh always collect a full snapshot.
PWNVIZ_SNAPSHOT_MODE=fast

# Stack window is read with ONE -data-read-memory-bytes request when it fits in
# this limit (default 0x400 = 1024 bytes, the default window is 0x200 = 512).
# Larger windows are split; a failed batch degrades to MEMORY_CHUNK_SIZE reads.
PWNVIZ_MEMORY_BATCH_MAX_BYTES=1024
PWNVIZ_MEMORY_CHUNK_SIZE=64

# Persistent GDB variable objects are refreshed with -var-update and rebuilt
# only when the frame changes. This is the hard object budget.
PWNVIZ_VARIABLE_CACHE_MAX_OBJECTS=192

# Safety upper bound: refresh cached frames at least every N snapshots even if
# no call/ret evidence was observed (0 disables the safety refresh).
PWNVIZ_FRAME_REFRESH_INTERVAL=12

# pygdbmi waits this long after a record to see whether more output belongs to
# the same batch. The MI controller correlates records by token and queues async
# notifications, so a shorter window only means the next record arrives on the
# next read. 0.1 (pygdbmi's default) added ~100-200 ms to EVERY MI command.
PWNVIZ_MI_SETTLE_SECONDS=0.01

# Number of SnapshotPerf records kept per session for p50/p95 aggregation.
PWNVIZ_PERF_HISTORY_SIZE=120

# Set to 1 to enable uvicorn auto-reload when starting with `python -m app`.
# PWNVIZ_RELOAD=0
